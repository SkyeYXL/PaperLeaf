    "test:browser": "node ../tests/v0.0.2/browser-smoke.mjs",
    "test:tags": "node ../tests/v0.0.2/tag-management-smoke.mjs",
    "test:home-preferences": "node ../tests/v0.0.2/home-preferences-smoke.mjs",
    "test:api-tokens": "node ../tests/v0.0.2/api-token-settings-smoke.mjs",
