PAPERLEAF_PORT=3080
# Docker host port. Keep 3080 unless the host already uses it.

# Used only when data/ is empty. Use a unique password of at least 12 characters,
# then change it after the first sign-in. Existing deployments keep their stored account.
PAPERLEAF_ADMIN_USER=admin
PAPERLEAF_ADMIN_PASSWORD=change-this-before-first-start
