# Docker only reads .dockerignore from the build-context root.
# The active rules are maintained in ../.dockerignore; retain this file as a
# human-readable mirror for Docker-related source inventory tools. In
# particular, assets/screenshots/ is README-only material and is not required
# by the runtime image.
node_modules/
data/
data-backups/
Library/
library/
backup/
tests/
extension/
scripts/
assets/
docs/
.env
*.sqlite
*.sqlite-shm
*.sqlite-wal
npm-debug.log*
