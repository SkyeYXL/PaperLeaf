{
  "manifest_version": 3,
  "name": "PaperLeaf · 纸笺",
  "version": "1.0.0",
  "description": "将当前网页或选中文字保存到 PaperLeaf 纸笺。",
  "action": {
    "default_title": "保存到纸笺",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": ["activeTab", "tabs", "storage", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "minimum_chrome_version": "109"
}
